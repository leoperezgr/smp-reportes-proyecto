{
  "name": "smp-reportes",
  "version": "1.0.4",
  "private": true,
  "description": "Generador de Reportes de Operación — Naviera SMP",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win --publish always",
    "electron:build:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "electron-updater": "^6.8.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.navierasmp.reportes",
    "productName": "SMP Reportes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "public/TEMPLATE-DEACERO.docx",
        "to": "TEMPLATE-DEACERO.docx"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "target": "dmg"
    },
    "publish": {
      "provider": "github",
      "owner": "leoperezgr",
      "repo": "smp-reportes-proyecto",
      "releaseType": "release"
    }
  }
}
